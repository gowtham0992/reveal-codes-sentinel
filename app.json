{
  "name": "reveal-codes-sentinel",
  "version": "0.1.1",
  "displayName": "Reveal Codes Sentinel",
  "description": "Schedules a nightly re-check of Reveal Codes court filings against CourtListener and reports citation, quotation and provenance drift in plain language.",
  "author": "gowtham0992",
  "license": "Apache-2.0",
  "repo": "https://github.com/gowtham0992/reveal-codes-sentinel",
  "tags": [
    "legal",
    "verification",
    "citations",
    "provenance"
  ],
  "agents": [
    "agents/sentinel.json"
  ],
  "skills": [
    "skills/sentinel-report"
  ],
  "crons": [
    {
      "name": "nightly-sweep",
      "cron_expr": "0 6 * * *",
      "agent": "sentinel",
      "enabled": false,
      "message": "Run the Reveal Codes sentinel sweep over the configured filings folder and report any drift.",
      "persistent_session": false
    }
  ],
  "permissions": {
    "cron": true,
    "network": true,
    "storage": true
  },
  "dependencies": {
    "commands": [
      "git",
      "node",
      "pnpm"
    ]
  },
  "setup": {
    "onInstall": "bash scripts/install.sh",
    "onEnable": "bash scripts/install.sh",
    "onEnableTimeout": 300,
    "onUninstall": "rm -rf vendor",
    "configSchema": {}
  }
}
